# Copy to ~/.mempalace/remote/env  (chmod 600) and fill in.
# Pick ONE auth mode below. passphrase mode needs only the passphrase;
# cloudflare-access mode needs the CF_ACCESS_* values instead.

# --- auth mode -------------------------------------------------------------
# passphrase (default when unset): this server is its own OAuth server, and
# the login page asks for MEMPALACE_REMOTE_PASSPHRASE.
# cloudflare-access: Cloudflare Access (Managed OAuth) signs you in at the
# edge; this server only accepts requests that carry Access's signed
# Cf-Access-Jwt-Assertion, and serves no login page. Any other value refuses
# to start.
# AUTH_MODE="passphrase"

MEMPALACE_REMOTE_PASSPHRASE="change-me-to-a-long-secret"

# cloudflare-access mode only (needs PyJWT in the service's interpreter — see
# the README install line):
# Zero Trust team domain, the issuer of every assertion.
# CF_ACCESS_TEAM_DOMAIN="https://your-team.cloudflareaccess.com"
# The Access application's "Application Audience (AUD) Tag".
# CF_ACCESS_AUD="0123456789abcdef..."
# Optional second check at the origin, on top of the Access policy:
# comma-separated, case-insensitive. Unset = any identity Access lets through.
# CF_ACCESS_ALLOWED_EMAILS="you@example.com"

# Public URL clients use. In passphrase mode it is the OAuth issuer, so it must
# match what publishes this port: the Funnel URL (port included unless 443) or
# the Cloudflare Tunnel hostname. Unused in cloudflare-access mode.
PUBLIC_BASE_URL="https://your-machine.your-tailnet.ts.net"

# Local bind (Funnel or the Tunnel forwards to here). Defaults shown.
BIND_HOST="127.0.0.1"
BIND_PORT="8789"

# Interpreter that run.sh launches the service with. Defaults to the mempalace
# uv tool venv, which is what `uv tool install mempalace` gives you. Set this
# only if mempalace lives somewhere else (another venv, a source checkout).
# Scope: this file configures the service. The other scripts in this repo take
# MEMPALACE_PYTHON from the shell instead (MEMPALACE_PYTHON=... ./script.sh).
# MEMPALACE_PYTHON="$HOME/.local/share/uv/tools/mempalace/bin/python"
