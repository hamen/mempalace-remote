# Run the MemPalace backup every 6 hours. Persistent=true catches runs missed
# while the machine was off (it never is, but belt-and-suspenders).
[Unit]
Description=Run MemPalace backup every 6 hours

[Timer]
OnCalendar=*-*-* 00,06,12,18:00:00
OnBootSec=2min
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
