#!/usr/bin/env bash
# Pre-push gate: tests, linters and the format check run on the commit being
# pushed. Enable once per clone: git config core.hooksPath .githooks
#
# The checks run on the working tree, so the hook refuses unless that tree IS
# the pushed commit: every pushed ref must point at HEAD, and no tracked file
# may carry uncommitted changes. (ship-feature land checks out the merge before
# it pushes, so the normal path satisfies this.)
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

RUFF="ruff@0.17.6"
zero="0000000000000000000000000000000000000000"
head="$(git rev-parse HEAD)"
pushing=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue   # a deletion cannot break anything
  pushing=1
  if [[ "$local_sha" != "$head" ]]; then
    echo "pre-push: refusing: the pushed commit ${local_sha:0:9} is not HEAD (${head:0:9})."
    echo "Check out the commit you push, then push again."
    exit 1
  fi
done
[[ $pushing -eq 0 ]] && exit 0
if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
  echo "pre-push: refusing: uncommitted changes would be checked instead of the pushed commit."
  git status --short --untracked-files=no
  exit 1
fi

step() { printf '\n== %s\n' "$1"; }

step "shellcheck"
git ls-files -z '*.sh' .githooks/pre-push | xargs -0 -r shellcheck -S warning

step "ruff check"
uvx "$RUFF" check .

step "ruff format --check"
uvx "$RUFF" format --check .

step "python tests"
uv run -q --isolated --no-project --with fastapi --with httpx \
  --with python-multipart --with 'pyjwt[crypto]' \
  python -m unittest discover -s tests </dev/null

step "shell tests"
git ls-files -z '*/test-*.sh' | while IFS= read -r -d '' t; do
  echo "-- $t"
  bash "$t" </dev/null
done

printf '\npre-push: all checks passed\n'
